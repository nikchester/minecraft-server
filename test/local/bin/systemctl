#!/usr/bin/env bash
# Stand-in for systemctl inside the test container (no systemd there at all).
# Only supports what our own scripts actually call (verified by grepping
# scripts/*.sh -- see test/local/README.md): `is-active --quiet`, `start`,
# and `stop`, always against minecraft.service. Anything else fails loudly
# rather than silently no-op-ing, so a script relying on more shim coverage
# than this fails the test instead of passing for the wrong reason.
set -euo pipefail

PID_FILE=${MINECRAFT_STUB_PID_FILE:-/tmp/minecraft-stub.pid}
STUB_SCRIPT=${MINECRAFT_STUB_SCRIPT:-/opt/test/stub/minecraft_stub.py}
STUB_PORT=${STUB_PORT:-25565}

quiet=false
no_block=false
subcommand=""
service=""
for arg in "$@"; do
  case "$arg" in
    --quiet) quiet=true ;;
    --no-block) no_block=true ;;
    -p|--value|ActiveState) ;;
    *.service|*.timer) service="$arg" ;;
    *) [[ -z "$subcommand" ]] && subcommand="$arg" ;;
  esac
done

if [[ "$subcommand" == "daemon-reload" ]]; then
  exit 0
fi

if [[ "$service" == "minecraft-deploy.timer" ]]; then
  timer_state_file=${MINECRAFT_DEPLOY_TIMER_STATE_FILE:-/tmp/minecraft-deploy-timer.state}
  case "$subcommand" in
    is-active|show)
      if [[ -f "$timer_state_file" ]] && [[ "$(cat "$timer_state_file")" == "active" ]]; then
        state=active
        status=0
      else
        state=inactive
        status=3
      fi
      if [[ "$subcommand" == "show" || "$quiet" != "true" ]]; then
        echo "$state"
      fi
      exit "$status"
      ;;
    start)
      printf 'active\n' >"$timer_state_file"
      exit 0
      ;;
    stop)
      printf 'inactive\n' >"$timer_state_file"
      exit 0
      ;;
  esac
fi

if [[ "$service" == "minecraft-deploy.service" || "$service" == "minecraft-deploy-force.service" ]]; then
  service_slug=${service%.service}
  service_state_file=${MINECRAFT_DEPLOY_SERVICE_STATE_FILE:-/tmp/${service_slug}.state}
  service_pid_file=${MINECRAFT_DEPLOY_SERVICE_PID_FILE:-/tmp/${service_slug}.pid}
  service_log_file=${MINECRAFT_DEPLOY_SERVICE_LOG_FILE:-/tmp/${service_slug}.log}
  case "$subcommand" in
    show|is-active)
      service_state=$(cat "$service_state_file" 2>/dev/null || echo inactive)
      if [[ "$subcommand" == "show" ]]; then
        echo "$service_state"
        exit 0
      fi
      case "$service_state" in
        active|activating|reloading)
          "$quiet" || echo "$service_state"
          exit 0
          ;;
        *)
          "$quiet" || echo "$service_state"
          exit 3
          ;;
      esac
      ;;
    start)
      service_state=$(cat "$service_state_file" 2>/dev/null || echo inactive)
      case "$service_state" in
        active|activating|reloading) exit 0 ;;
      esac
      printf 'activating\n' >"$service_state_file"
      (
        set +e
        if [[ "$service" == "minecraft-deploy-force.service" ]]; then
          FORCE_DEPLOY=true "$MINECRAFT_BIN_DIR/deploy.sh"
        else
          "$MINECRAFT_BIN_DIR/deploy.sh"
        fi
        result=$?
        if [[ "$result" -eq 0 ]]; then
          printf 'inactive\n' >"$service_state_file"
        else
          printf 'failed\n' >"$service_state_file"
        fi
        exit "$result"
      ) >"$service_log_file" 2>&1 &
      service_pid=$!
      printf '%s\n' "$service_pid" >"$service_pid_file"
      if [[ "$no_block" == "true" ]]; then
        exit 0
      fi
      wait "$service_pid"
      ;;
    status)
      printf '%s\n' "$(cat "$service_state_file" 2>/dev/null || echo inactive)"
      ;;
    stop)
      if [[ -f "$service_pid_file" ]]; then
        service_pid=$(cat "$service_pid_file")
        kill "$service_pid" 2>/dev/null || true
      fi
      printf 'inactive\n' >"$service_state_file"
      ;;
  esac
  exit 0
fi

if [[ "$service" != "minecraft.service" ]]; then
  echo "systemctl shim: only minecraft.service is supported (got: '${service}')" >&2
  exit 1
fi

is_running() {
  [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$subcommand" in
  is-active)
    if is_running; then
      "$quiet" || echo active
      exit 0
    else
      "$quiet" || echo inactive
      exit 3
    fi
    ;;
  start)
    if is_running; then
      exit 0
    fi
    # deploy.sh's verify_release greps the current release's logs for
    # AuthMe load evidence -- a real Paper+AuthMe start would produce
    # this; the stub doesn't run a JVM at all, so faking that one line as
    # a side effect of "starting" is the shim's job, not the release
    # fixture's (prepare-release.sh's own output should stay realistic).
    current_dir=${MINECRAFT_CURRENT_DIR:-/srv/minecraft/current}
    mkdir -p "${current_dir}/logs"
    printf '[stub] [AuthMe] AuthMe enabled (test stub, not real Paper)\n' >>"${current_dir}/logs/latest.log"
    if [[ ! -f "${current_dir}/.omit_onlysleep_enable_log" ]]; then
      printf '[stub] [Onlysleep] Enabling Onlysleep v1.4.2 (test stub, not real Paper)\n' >>"${current_dir}/logs/latest.log"
    fi
    if [[ -f "${current_dir}/.force_fail" ]]; then
      # For testing deploy.sh's rollback path: a release with this marker
      # file intentionally never gets its stub launched, so the port-wait
      # loop below times out and this command fails exactly the way a real
      # Paper crash-on-boot would fail `systemctl start`. Keyed off the
      # release directory (not a blanket env var) so that when deploy.sh
      # rolls back to the PREVIOUS release, that release's own start
      # succeeds normally instead of failing the rollback too.
      :
    else
      python3 "$STUB_SCRIPT" >>/tmp/minecraft-stub.log 2>&1 &
      echo $! >"$PID_FILE"
    fi
    # Give it a moment to actually bind before returning, matching real
    # systemctl start's blocking-until-ready behavior closely enough for
    # scripts that immediately try to connect.
    for _ in $(seq 1 20); do
      if (exec 3<>"/dev/tcp/127.0.0.1/${STUB_PORT}") 2>/dev/null; then
        exec 3>&-
        exit 0
      fi
      sleep 0.1
    done
    echo "systemctl shim: stub did not start listening on port ${STUB_PORT} in time" >&2
    exit 1
    ;;
  stop)
    if ! is_running; then
      exit 0
    fi
    pid=$(cat "$PID_FILE")
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
    exit 0
    ;;
  *)
    echo "systemctl shim: unsupported subcommand '${subcommand}'" >&2
    exit 1
    ;;
esac
